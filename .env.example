# Copy this file to `.env` and fill in real values. `.env` is gitignored --
# never commit it. This file (.env.example) holds no secrets, only the
# names of the variables JARVIS reads, so it's safe to commit.

APP_NAME=JARVIS
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Leave unset to use the default (backend/jarvis.db). Switching to Postgres
# later means changing only this line.
# DATABASE_URL=sqlite:///./jarvis.db

# --- LLM ---------------------------------------------------------------------
# Which provider adapter to load: anthropic | ollama
#   anthropic - Claude via the cloud API. Best quality, costs money, needs a key.
#   ollama    - a model running locally. Free and private, but slower and
#               weaker at tool use. No key needed.
# Switching between them is this one line. No code changes.
LLM_PROVIDER=anthropic

# Model to use. See https://platform.claude.com/docs for the current list.
LLM_MODEL=claude-opus-5

# How hard the model thinks before answering: low | medium | high | xhigh | max
# "low"    - fastest and cheapest; good for quick chat
# "medium" - balanced (default)
# "high"+  - slower and pricier, better on hard reasoning and coding
LLM_EFFORT=medium

# Your API key from https://console.anthropic.com/settings/keys
# Only needed when LLM_PROVIDER=anthropic.
# This file (.env.example) is committed; your real .env is gitignored.
# NEVER put a real key in this file. Never paste a key into a chat or an issue.
ANTHROPIC_API_KEY=

# --- Voice (Phase 7) ----------------------------------------------------------
# Speech to text. Model size: tiny | base | small | medium | large-v3.
# Downloaded automatically on first use and cached. "small" is ~485MB and
# runs at roughly 2x realtime on a 4-core CPU.
STT_PROVIDER=whisper
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# Text to speech. Download a voice first:
#   python -m piper.download_voices <name> --download-dir backend/models/piper
# Browse them at https://rhasspy.github.io/piper-samples/
TTS_PROVIDER=piper
TTS_VOICE=en_GB-alan-medium

# --- File system tools (Phase 9) -----------------------------------------------
# The ONLY directory tree tools may touch. Every path is resolved (following
# symlinks and '..') and checked against this before anything happens, so a
# path that merely LOOKS inside cannot escape. Defaults to your home folder,
# which keeps C:\Windows and Program Files out of reach. Narrow it to a single
# workspace for a tighter blast radius.
FS_ROOT=

# Caps on how much a single call can return, so a tool cannot load a huge
# file into memory and then into a prompt.
FS_MAX_READ_BYTES=200000
FS_MAX_ENTRIES=200

# How long an approval stays valid, in seconds. A stale "yes" must not be
# redeemable later against a request you have forgotten agreeing to.
TOOL_CONFIRMATION_TTL_SECONDS=300

# --- Vision (Phase 8) ---------------------------------------------------------
# Which engine answers questions about images: anthropic | ollama
#
# Measured on a 4-core CPU with no GPU: the local option (moondream, 1.8B)
# takes ~20s per image and is weak on screenshots -- it described a desktop
# as "irc". Claude is fast and accurate but costs roughly 1-2 cents per
# image. For reading TEXT off the screen, use /vision/ocr instead of either:
# it is local, free, and read 38 lines of a real screenshot in 4.5 seconds.
VISION_PROVIDER=anthropic
VISION_MODEL=claude-opus-5
OLLAMA_VISION_MODEL=moondream

# OCR runs locally on onnxruntime. No API key, no external binary.
OCR_PROVIDER=rapidocr

# Longest edge a captured image is scaled down to before analysis.
VISION_MAX_DIMENSION=1568

# --- Ollama (only used when LLM_PROVIDER=ollama) ------------------------------
# Download a model first:  ollama pull llama3.2
# llama3.2 is ~2GB and runs acceptably on a CPU. llama3.1 (8B, ~4.7GB) is
# better but noticeably slower without a dedicated GPU.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Speaking rate. 1.0 is the voice default; higher is faster. Short replies
# feel draggy at 1.0 because of sentence-final pauses; 1.25 is snappier
# without sounding rushed.
TTS_SPEED=1.25

# --- Automation (Phase 11) ---------------------------------------------------
# How often the scheduler asks the database whether a reminder is due. A
# reminder can be up to this many seconds late -- the trade for a scheduler
# that holds no state and survives restarts.
REMINDER_CHECK_SECONDS=20

# Guard against a model miscalculating a date and scheduling for the year 3000.
REMINDER_MAX_DAYS_AHEAD=365

# --- Scheduled tasks (Phase 11b) ---------------------------------------------
# A scheduled task is a PROMPT JARVIS runs to itself on a repeat -- "every
# morning at 8, summarise my reminders". Unlike a reminder, each run is a full
# model call, which is what the two limits below are really about.

# How often to check whether a task is due. Separate from the reminder check
# because a due reminder is a string lookup and a due task costs money.
TASK_CHECK_SECONDS=30

# The shortest repeat allowed, in seconds. This is a spending limit as much as
# a sanity check: "every 5 seconds" would quietly burn API credit all night.
TASK_MIN_INTERVAL_SECONDS=300

# How many active tasks one user may have, so a confused model cannot fill
# the table with standing instructions.
TASK_MAX_ACTIVE=20

# --- File watchers (Phase 11c) -----------------------------------------------
# Watched folders report what changed and nothing more. A filename is never
# built into a prompt and no model is called, so a file written by someone
# else cannot become an instruction to an agent holding tools.
WATCHERS_ENABLED=true

# Ignore repeat changes to the same file within this many seconds. Saving a
# file in an editor fires several OS events -- a temp write, a rename, a
# metadata touch -- and reporting each is noise rather than information.
WATCH_DEBOUNCE_SECONDS=2.0

# Hard cap on notifications per minute. A git checkout or an unzip can fire
# thousands of events in a second; past this the watcher sends one summary
# line and goes quiet for the rest of the minute.
WATCH_MAX_EVENTS_PER_MINUTE=60

# How many folders may be watched at once.
WATCH_MAX_FOLDERS=10

# How often the watcher re-reads the database, so a newly added watch starts
# working. The tools only write rows; nothing reaches into the running
# observer, which is what lets a restart need no recovery code.
WATCH_SYNC_SECONDS=30

# --- Plugins (Phase 12) -------------------------------------------------------
# A plugin is a .py file dropped into plugins/ that adds a tool. It goes
# through the same confirmation gate and audit log as anything built in, and
# it cannot take a built-in's name.
#
# It is also ordinary Python running in this process with this process's
# permissions -- there is no sandbox. Install plugins you trust, the way you
# would treat any Python package. Set this to false to disable the mechanism
# entirely. See docs/plugins.md.
PLUGINS_ENABLED=true

# Folder plugins are read from. Defaults to plugins/ beside this file.
# PLUGINS_DIR=
